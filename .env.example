# Copy this file to `ci/.env` for local development.
# The real `ci/.env` file should stay uncommitted.

# Optional image tag overrides used by Docker Compose
# FRONTEND_TAG=1.2.3
# CASEWORK_TAG=1.0.25
# WORKFLOW_TAG=latest
# CASE_CREATOR_TAG=1.2.4
# INFO_TAG=f99d9a7573e93f1c664ce11e0189764a688dbee4
# HOCS_DATA_TAG=1.0.0
# HOCS_DATA_REPO=hocs-data

# Frontend auth proxy headers
# Required for a realistic authenticated session:
FRONTEND_PROXY_AUTH_USER_ID=
FRONTEND_PROXY_AUTH_ROLES=
FRONTEND_PROXY_AUTH_GROUPS=

# Optional overrides:
# FRONTEND_PROXY_AUTH_USERNAME=my-user
# FRONTEND_PROXY_AUTH_TOKEN=1234456

# X-Auth-Subject is derived automatically from FRONTEND_PROXY_AUTH_USER_ID.

