server {
    listen 8080;
    server_name _;

    resolver 127.0.0.11 ipv6=off valid=30s;
    set $frontend_upstream "${PROXY_UPSTREAM}";
    __PROXY_AUTH_GROUPS_SET__

    location / {
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_redirect off;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Auth-UserId "${PROXY_AUTH_USER_ID}";
        proxy_set_header X-Auth-Token "${PROXY_AUTH_TOKEN}";
        proxy_set_header X-Auth-Groups $proxy_auth_groups;
        proxy_set_header X-Auth-Username "${PROXY_AUTH_USERNAME}";
        proxy_set_header X-Auth-Subject "${PROXY_AUTH_SUBJECT}";
        proxy_set_header X-Auth-Roles "${PROXY_AUTH_ROLES}";
    }
}

